# Public Firebase web configuration (Vite exposes only VITE_ variables)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=

# Configure one server credential method:
# Option A: local service account file kept out of version control
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Option B: production/Application Default Credentials
# FIREBASE_USE_ADC=true
# Option C: service account JSON string (keep secret; never commit)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# External provider keys — backend only, never prefix these with VITE_
VIRUSTOTAL_API_KEY=
ZEROBOUNCE_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.7
